<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/flowy_pressed" />
            <stroke android:width="2dp" android:color="@color/flowy_focus_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/flowy_focus" />
            <stroke android:width="3dp" android:color="@color/flowy_focus_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/flowy_key" />
            <stroke android:width="1dp" android:color="@color/flowy_key_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
