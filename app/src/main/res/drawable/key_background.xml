<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#32203D" />
            <stroke android:width="1dp" android:color="#FF2BD6" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1B2840" />
            <stroke android:width="2dp" android:color="#00F5FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#171D2B" />
            <stroke android:width="1dp" android:color="#35415D" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>