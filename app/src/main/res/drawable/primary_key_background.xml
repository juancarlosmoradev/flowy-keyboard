<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#68D9C8" android:endColor="#8E9EFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#8BF2DC" android:endColor="#A9B6FF" />
            <stroke android:width="2dp" android:color="@color/flowy_text" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#79EBD7" android:endColor="#9DAAFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</selector>
