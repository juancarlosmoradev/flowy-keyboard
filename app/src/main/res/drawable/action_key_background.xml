<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#39465F" android:endColor="@color/flowy_action_pressed" />
            <stroke android:width="1dp" android:color="@color/flowy_accent" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4A5877" android:endColor="@color/flowy_focus" />
            <stroke android:width="2dp" android:color="@color/flowy_focus_border" />
            <corners android:radius="17dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2B354B" android:endColor="@color/flowy_action" />
            <stroke android:width="1dp" android:color="@color/flowy_key_border" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</selector>
